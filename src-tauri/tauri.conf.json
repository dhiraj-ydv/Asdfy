{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TypeDH",
  "version": "0.1.2",
  "identifier": "io.github.exolithelabs.ColemakDHTutor",
  "build": {
    "beforeDevCommand": "npm --prefix frontend run dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "npm --prefix frontend run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "TypeDH",
        "width": 1180,
        "height": 820,
        "minWidth": 800,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "publisher": "Exolithe Labs",
    "copyright": "Copyright 2026 Exolithe Labs",
    "category": "Education",
    "shortDescription": "TypeDH — Colemak-DH typing tutor",
    "longDescription": "TypeDH is a focused desktop touch-typing tutor with progressive Colemak-DH lessons, live finger guidance, and private local progress tracking.",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}
