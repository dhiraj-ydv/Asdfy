{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Asdfy",
  "version": "0.2.2",
  "identifier": "io.github.exolithelabs.asdfy",
  "build": {
    "beforeDevCommand": "npm --prefix frontend run dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "node scripts/third-party-notices.mjs && npm --prefix frontend run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Asdfy",
        "width": 1180,
        "height": 820,
        "minWidth": 800,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "nsis", "dmg"],
    "category": "Education",
    "shortDescription": "Touch-typing tutor",
    "longDescription": "Asdfy is a focused desktop touch-typing tutor for the QWERTY layout, with a staged course, smart practice on your weakest keys, speed tests, and private local statistics.",
    "copyright": "Copyright 2026 Exolithe Labs",
    "publisher": "Exolithe Labs",
    "license": "Apache-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY1QzVFRDA5MDYzMjc3ODIKUldTQ2R6SUdDZTNGWlZjdDdyVVd0WXBraVQzdlBneGptUHcvTHMzR1VKdm1STzVOTVRhM20vWHoK",
      "endpoints": [
        "https://github.com/exolithelabs/Asdfy/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
